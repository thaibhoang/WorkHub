# ~/workhub/.env on the server. Never commit the real one.

# Postgres password (URL-safe): openssl rand -hex 24
POSTGRES_PASSWORD=

# Public origin (cookie Secure flag + cross-origin write check)
WH_PUBLIC_URL=https://workhub.buihoangthai.com

# 1 = also run the pipeline (agents spend money). Keep 0 until Claude/GitHub
# credentials and the factory's repo are set up (deploy/README.md).
WH_FOREMAN=0
WH_MAX_PARALLEL=1
# WH_FACTORY=/repos/<repo>/factory/factory.yaml

# Claude Code auth for agents: an API key, or a subscription token from `claude setup-token`
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# GitHub for gh/git (ship, PR polling, issue intake): fine-grained PAT
# GH_TOKEN=

# Set by deploy.sh
WH_IMAGE=workhub:latest
